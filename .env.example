# Local PostgreSQL settings for Philtech Payroll
# Copy this file to .env and update the values before running the server.

# Database Configuration
# Option 1: Use a full database URL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/payroll_db

# Option 2: Use explicit PostgreSQL env vars instead
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=payroll_db

# Application Settings
PORT=10000
NODE_ENV=development
HOST=0.0.0.0

# Security Secrets (Generate random values for production)
JWT_SECRET=your-jwt-secret-key-change-in-production
SESSION_SECRET=your-session-secret-key-change-in-production

# Firebase Configuration (Optional)
# Leave empty or {} if Firebase is not configured
FIREBASE_SERVICE_ACCOUNT={}

# For Render Deployment
# These environment variables are automatically managed by Render:
# - DATABASE_URL (from PostgreSQL add-on)
# - PORT (assigned by Render)
# - NODE_ENV=production (set by Render)
# - JWT_SECRET (generate in Render dashboard)
# - SESSION_SECRET (generate in Render dashboard)

